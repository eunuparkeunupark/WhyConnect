rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // post media + video posters
    match /posts/{uid}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 200 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)')
            || request.resource.contentType.matches('video/(mp4|webm|quicktime)'));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // profile pictures
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}

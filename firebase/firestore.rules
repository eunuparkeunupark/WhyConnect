rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function root() { return /databases/$(database)/documents; }

    // ---- profiles ----
    match /users/{uid} {
      allow read: if true;
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['username', 'name', 'bio', 'avatar', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_.]{3,24}$')
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 200
        && (request.resource.data.avatar == null || request.resource.data.avatar is string)
        && request.resource.data.createdAt == request.time;
      allow update: if isUser(uid)
        && changed().hasOnly(['name', 'bio', 'avatar'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 200
        && (request.resource.data.avatar == null || request.resource.data.avatar is string);
      allow delete: if false;
    }

    // ---- username claims (unique, immutable) ----
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_.]{3,24}$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    // ---- posts ----
    match /posts/{postId} {
      allow read: if true;
      allow create: if isUser(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'title', 'type', 'media', 'mediaPath', 'thumb', 'thumbPath', 'width', 'height', 'views', 'likes', 'comments', 'createdAt', 'blocks', 'excerpt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
        && request.resource.data.width is int && request.resource.data.height is int
        && request.resource.data.width > 0 && request.resource.data.height > 0
        && request.resource.data.views == 0 && request.resource.data.likes == 0 && request.resource.data.comments == 0
        && request.resource.data.createdAt == request.time
        && (
          // single photo / video post
          (request.resource.data.type in ['photo', 'video']
            && !request.resource.data.keys().hasAny(['blocks', 'excerpt'])
            && request.resource.data.media is string && request.resource.data.media.matches('^https?://.*')
            && request.resource.data.mediaPath is string && request.resource.data.mediaPath.matches('^posts/' + request.auth.uid + '/.*'))
          // article "Post": rows of rich text + optional media (HTML is sanitized by the client when rendering)
          || (request.resource.data.type == 'post'
            && request.resource.data.blocks is list
            && request.resource.data.blocks.size() >= 1 && request.resource.data.blocks.size() <= 20
            && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 200
            && !request.resource.data.keys().hasAny(['media', 'mediaPath']))
        );

      // counters: +1 view for anyone, ±1 like backed by a like doc, comment count within a sane range
      allow update:
        if (changed().hasOnly(['views'])
              && request.resource.data.views == resource.data.views + 1)
        || (signedIn() && changed().hasOnly(['likes'])
              && ((request.resource.data.likes == resource.data.likes + 1
                    && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
                    && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
               || (request.resource.data.likes == resource.data.likes - 1
                    && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
                    && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))))
        || (signedIn() && changed().hasOnly(['comments'])
              && request.resource.data.comments >= 0
              && request.resource.data.comments - resource.data.comments <= 1
              && request.resource.data.comments - resource.data.comments >= -100);

      allow delete: if isUser(resource.data.uid);

      match /likes/{uid} {
        allow read: if true;
        allow create: if isUser(uid);
        allow delete: if isUser(uid)
          || isUser(get(/databases/$(database)/documents/posts/$(postId)).data.uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'parentId', 'body', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isUser(resource.data.uid)
          || isUser(get(/databases/$(database)/documents/posts/$(postId)).data.uid)
          || (resource.data.parentId != null
              && isUser(get(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId)).data.uid));
      }
    }
  }
}
